{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    // Typed view of the SDK's agent subpath (vite aliases it to the built bundle).
    "paths": { "@sdk/agent": ["../sdk/src/agent/index.ts"] }
  },
  "include": ["src"]
}
